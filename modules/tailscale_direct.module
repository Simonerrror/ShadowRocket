#!url=https://raw.githubusercontent.com/Simonerrror/ShadowRocket/main/modules/tailscale_direct.module
#!name=Tailscale
#!desc=Keep Tailscale tailnet traffic inside Shadowrocket TUN and route it by the built-in TAILSCALE policy.

[Rule]
IP-CIDR,100.64.0.0/10,TAILSCALE,no-resolve
DOMAIN-SUFFIX,ts.net,TAILSCALE
