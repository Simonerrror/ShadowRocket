#!url=https://raw.githubusercontent.com/Simonerrror/ShadowRocket/main/modules/tailscale_direct.module
#!name=Tailscale Direct
#!desc=Keep Tailscale tailnet traffic out of Shadowrocket proxy routing.

[General]
skip-proxy = 100.100.100.100, *.ts.net, *.tailscale.com
tun-excluded-routes = 100.64.0.0/10

[Rule]
IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
IP-CIDR,100.100.100.100/32,DIRECT,no-resolve
DOMAIN-SUFFIX,ts.net,DIRECT
DOMAIN-SUFFIX,tailscale.com,DIRECT
