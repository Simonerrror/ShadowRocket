#!name=01_01 · DNS Override Example
#!desc=Example: создайте локальный модуль из этого текста и впишите свои DNS. URL обновления отсутствует.

# Локальный пример: персональные адреса DNS задаются только в вашей копии.
# Не импортируйте этот образец повторно поверх уже заполненного модуля.

[General]
# Основной DNS: замените адрес своим приватным DNS при необходимости.
dns-server = 9.9.9.9
# Обязательно впишите Smart DNS после знака = перед включением модуля.
direct-dns-server =
dns-direct-system = false
