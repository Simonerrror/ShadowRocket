#!name=01 · DNS Override
#!desc=Перед включением откройте текст модуля и впишите Smart DNS после direct-dns-server =. Основной DNS можно заменить своим приватным.
#!url=https://raw.githubusercontent.com/Simonerrror/ShadowRocket/main/modules/dns_override.module

[General]
# Основной DNS: замените адрес своим приватным DNS при необходимости.
dns-server = 9.9.9.9
# Обязательно впишите Smart DNS после знака = перед включением модуля.
direct-dns-server =
dns-direct-system = false
