#!name=01 · DNS Override
#!desc=Smart DNS для прямых запросов. Основной и резервный DNS остаются из конфига.
#!url=https://raw.githubusercontent.com/Simonerrror/ShadowRocket/main/modules/dns_override.module
#!arguments=SmartDNS:
#!arguments-desc=SmartDNS: адрес Smart DNS. Заполните перед включением; обычный публичный DNS здесь не заменяет Smart DNS.

[General]
direct-dns-server = {{{SmartDNS}}}
dns-direct-system = false
