#!url=https://raw.githubusercontent.com/Simonerrror/ShadowRocket/main/modules/GFN-AM.module
#!icon=https://raw.githubusercontent.com/Simonerrror/ShadowRocket/main/modules/icons/GFN-AM.png
#!name=20_01 · GFN Direct
#!desc=2026.11.08.1 · Только каталог через PROXY без фильтра стран; авторизация, запуск и поток DIRECT.

# Используйте маршрутизацию «Конфигурация»; модуль должен быть выше Anti-Advertising.
# Каталог использует действующую группу PROXY основного профиля.
# Видимость отдельных игр зависит от региона выхода выбранного прокси.

[General]
# Сохраняем реальные адреса NVIDIA/GFN вместо Fake IP.
always-real-ip = *.nvidiagrid.net,*.geforcenow.com,*.nvidia.com

[Rule]
# Единственное прокси-исключение: каталог приложения GeForce NOW.
DOMAIN,apps.gxn.nvidia.com,PROXY

# Авторизация, служебные API, создание сессии и игровой поток — напрямую.
DOMAIN-SUFFIX,gfn.am,DIRECT
DOMAIN-SUFFIX,nvidia.com,DIRECT
DOMAIN-SUFFIX,geforce.com,DIRECT
DOMAIN-SUFFIX,geforcenow.com,DIRECT
DOMAIN-SUFFIX,nvidiagrid.net,DIRECT
IP-CIDR,37.186.111.0/24,DIRECT,no-resolve
